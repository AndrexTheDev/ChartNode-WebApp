-  const exchange = pickExchange({ symbol, timeframe, country, reach, unsupported, preferred: effectivePreferred });
+  /*
+   * `current` ist die Venue, die für dieses Symbol gerade gecharted wird. Sie
+   * dient `pickExchange` als Hysterese-Anker: ein einzelner fehlgeschlagener
+   * Reachability-Probe darf den Chart nicht unter der Hand des Nutzers
+   * wegziehen (siehe `stickTo` in lib/exchange-select).
+   */
+  const exchange = pickExchange({
+    symbol,
+    timeframe,
+    country,
+    reach,
+    unsupported,
+    preferred: effectivePreferred,
+    current: preferred[symbol] ?? (isCexExchange(tokenExchange) ? (tokenExchange as ExchangeId) : null),
+  });
   const wanted = preferred[symbol] ?? (isCexExchange(tokenExchange) ? tokenExchange : null);
   return { exchange, rerouted: Boolean(wanted && wanted !== exchange) };
 }
