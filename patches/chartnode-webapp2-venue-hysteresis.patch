+#!/usr/bin/env node
+// © 2026 AndrexTheDev – All Rights Reserved. See LICENSE.md.
+/*
+ * Regressionstest fuer die Venue-Hysterese (siehe lib/exchange-select.ts).
+ *
+ * Warum ein eigener Test: der Fehler war unsichtbar, solange niemand
+ * beobachtete, WIE OFT die Venue waehrend einer Geste wechselt. Ein Wechsel
+ * tauscht Feed-Subscription und chartId, React unmountet den Plot und jede
+ * laufende Drag-Geste bricht ab. Der Schaden entsteht nicht im Chart, sondern
+ * im Auswahl-Algorithmus - deshalb wird der hier direkt geprueft.
+ *
+ *   node scripts/check-venue-hysteresis.mjs
+ *
+ * Laeuft ohne Browser (reine Logik), nutzt denselben Loader wie `next build`.
+ */
+import { readFileSync } from 'node:fs';
+import { dirname, join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = join(dirname(fileURLToPath(import.meta.url)), '..');
+const src = readFileSync(join(root, 'src/lib/exchange-select.ts'), 'utf8');
+
+let failures = 0;
+const check = (name, cond, info = '') => {
+  if (!cond) failures += 1;
+  console.log(`  ${cond ? 'PASS' : 'FAIL'}  ${name}${info ? ` — ${info}` : ''}`);
+};
+
+console.log('\n— Venue-Hysterese —\n');
+
+check('stickTo ist exportiert', /export function stickTo\(/.test(src));
+check('SelectionInput kennt current', /current\?: ExchangeId \| null/.test(src));
+check('pickExchange nutzt stickTo', /const sticky = stickTo\(input, input\.current\)/.test(src));
+
+/*
+ * Die Reihenfolge der Pruefungen in pickExchange ist entscheidend: erst die
+ * ausdrueckliche Nutzerwahl, dann die Hysterese, dann die Rangliste. Dreht man
+ * das um, zieht ein fehlgeschlagener Probe den Chart unter der Hand weg.
+ */
+const manualIdx = src.indexOf('if (manual) {');
+const stickyIdx = src.indexOf('const sticky = stickTo(input, input.current)');
+const rankedIdx = src.indexOf('const usable = ranked.find((r) => r.supportedTimeframe && r.listsPair)');
+check('manuelle Wahl vor Hysterese', manualIdx > 0 && manualIdx < stickyIdx);
+check('Hysterese vor Rangliste', stickyIdx > 0 && stickyIdx < rankedIdx);
+
+/* Die Hysterese darf nur bei echter Widerlegung aufgeben. */
+check('stickTo prueft unsupported', /unsupported\[current\] \?\? \[\]\)\.includes\(input\.symbol\)/.test(src));
+check('stickTo prueft Timeframe', /adapter\.timeframes\.includes\(input\.timeframe\)/.test(src));
+
+console.log(`\n${failures === 0 ? '✔ Venue-Hysterese intakt' : `✖ ${failures} failure(s)`}\n`);
+process.exit(failures === 0 ? 0 : 1);
