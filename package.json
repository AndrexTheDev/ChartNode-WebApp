{
  "name": "nodechart",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "NodeChart – Decode the Market. Free, Fast, Decentralized. A 100% free, client-side TradingView alternative for CEX & DEX.",
  "author": "AndrexTheDev <hippie.highho@gmail.com>",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "ws:smoke": "node scripts/run-harness.mjs ws-smoke.entry.ts",
    "check:i18n": "node scripts/check-i18n.mjs",
    "api:smoke": "node scripts/run-harness.mjs api-smoke.entry.ts",
    "chart:smoke": "node scripts/run-harness.mjs chart-smoke.entry.ts",
    "smoke": "npm run ws:smoke && npm run api:smoke && npm run chart:smoke && npm run edge:smoke",
    "beta": "node scripts/beta-test.mjs",
    "edge:smoke": "node scripts/run-harness.mjs edge-smoke.entry.ts",
    "audit:css": "node scripts/tw-missing.mjs",
    "qa:interaction": "node scripts/qa-interaction.mjs",
    "qa:i18n": "node scripts/qa-i18n-layout.mjs",
    "qa:monetization": "node scripts/qa-monetization.mjs",
    "qa:release": "node scripts/qa-release.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "1.43.0",
    "next": "16.3.4",
    "next-intl": "4.14.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.6.0",
    "technicalindicators": "^3.1.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.5.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "postcss": "8.5.28",
    "puppeteer": "^24.43.1",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.9.3",
    "wrangler": "4.130.0"
  }
}
