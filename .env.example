# ── Adsterra (all formats are plain script URLs from the publisher dashboard) ──
# Leave empty for local development – the app then renders zero ad slots.
# Adsterra bids mobile and desktop traffic separately, so each format has a
# per-device variable; the legacy single-value variable falls back for both.
# Example value: https://pl24617815.revenuecpmgate.com/inv/js/9c0a1e7b3f5d8e2a.js
#
# Native Banner (rail/strip-Slots): desktop = right rail (lg+), mobile = strip
NEXT_PUBLIC_ADSTERRA_NATIVE_DESKTOP=
NEXT_PUBLIC_ADSTERRA_NATIVE_MOBILE=
# Header-Native-Banner (4:1, alle Seiten außer Terminal): Default = echter
# nodechart.cc-Code aus src/lib/ads/config.ts – nur zum Überschreiben setzen
# NEXT_PUBLIC_ADSTERRA_NATIVE_BANNER_SRC=
# Linke Terminal-Sidebar Banner 160x600 (Desktop only): Default = atOptions-Key
# 91280e04… + Loader-Fallback-Kette; volle invoke.js-Zeile aus dem Dashboard:
# Basis-URL für Canonical/OG/Sitemap (Default https://nodechart.cc)
# NEXT_PUBLIC_SITE_URL=
# NEXT_PUBLIC_ADSTERRA_SIDEBAR_SRC=
# Social Bar: self-anchors to the viewport bottom (app pages only).
# DEFAULT: the real nodechart.cc delivery script is bundled in
# src/lib/ads/config.ts – set these only to override with another placement.
NEXT_PUBLIC_ADSTERRA_SOCIALBAR_DESKTOP=
NEXT_PUBLIC_ADSTERRA_SOCIALBAR_MOBILE=
# Popunder: armed once per session on the 2x1/2x2 gesture.
# DEFAULT: the real nodechart.cc delivery script is bundled in
# src/lib/ads/config.ts – set these only to override it with another placement.
NEXT_PUBLIC_ADSTERRA_POPUNDER_DESKTOP=
NEXT_PUBLIC_ADSTERRA_POPUNDER_MOBILE=
# Legacy fallbacks (used for both devices when the per-device var is empty)
NEXT_PUBLIC_ADSTERRA_NATIVE=
NEXT_PUBLIC_ADSTERRA_SOCIALBAR=
NEXT_PUBLIC_ADSTERRA_POPUNDER=
# Smartlink/Direct-Link (Default = fester nodechart.cc-Link, siehe src/lib/ads/smartlinks.ts)
# NEXT_PUBLIC_ADSTERRA_SMARTLINK_URL=
# NEXT_PUBLIC_SMARTLINKS_ENABLED=false  # Kill-Switch für alle Smartlinks
